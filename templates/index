<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="UTF-8">
    <meta name="viewport" content="width=device-width, initial-scale=1.0">
    <title>Custom Phone Remote Dashboard</title>
    <style>
        * {
            box-sizing: border-box;
            margin: 0;
            padding: 0;
            font-family: system-ui, -apple-system, BlinkMacSystemFont, 'Segoe UI', Roboto, Oxygen, Ubuntu, Cantarell, sans-serif;
        }

        body {
            background-color: #0b0f19;
            color: #f1f5f9;
            display: flex;
            height: 100vh;
            overflow: hidden;
        }

        /* --- Left Video/Screen Stream Pane --- */
        .stream-container {
            flex: 1;
            display: flex;
            justify-content: center;
            align-items: center;
            background: #020617;
            padding: 16px;
            position: relative;
        }

        #phone-screen {
            max-height: 94vh;
            max-width: 100%;
            border-radius: 16px;
            border: 2px solid #0284c7;
            box-shadow: 0 10px 25px -5px rgba(0, 0, 0, 0.5), 0 8px 10px -6px rgba(0, 0, 0, 0.5);
            cursor: pointer;
            object-fit: contain;
            user-select: none;
            -webkit-user-drag: none;
        }

        /* --- Right Control Sidebar --- */
        .controls-sidebar {
            width: 340px;
            background: #1e293b;
            padding: 24px 20px;
            display: flex;
            flex-direction: column;
            gap: 20px;
            border-left: 1px solid #334155;
            overflow-y: auto;
        }

        .section-title {
            font-size: 13px;
            font-weight: 700;
            color: #38bdf8;
            text-transform: uppercase;
            letter-spacing: 0.05em;
            margin-bottom: 8px;
        }

        .btn-grid {
            display: grid;
            grid-template-columns: repeat(3, 1fr);
            gap: 8px;
        }

        .control-btn {
            padding: 12px 6px;
            font-size: 13px;
            font-weight: 600;
            background: #334155;
            color: #f8fafc;
            border: 1px solid #475569;
            border-radius: 8px;
            cursor: pointer;
            transition: background 0.15s ease, transform 0.05s ease;
        }

        .control-btn:hover {
            background: #475569;
        }

        .control-btn:active {
            background: #0284c7;
            transform: scale(0.97);
        }

        /* --- Text Input Section --- */
        .input-group {
            display: flex;
            flex-direction: column;
            gap: 10px;
        }

        .text-field {
            width: 100%;
            padding: 12px;
            border-radius: 8px;
            border: 1px solid #475569;
            background: #0f172a;
            color: #fff;
            font-size: 14px;
            outline: none;
        }

        .text-field:focus {
            border-color: #38bdf8;
        }

        .submit-btn {
            padding: 12px;
            background: #0284c7;
            border: none;
            border-radius: 8px;
            color: white;
            font-size: 14px;
            font-weight: bold;
            cursor: pointer;
            transition: background 0.15s ease;
        }

        .submit-btn:hover {
            background: #0369a1;
        }

        /* --- Instructions & Tips --- */
        .info-card {
            background: #0f172a;
            border: 1px solid #334155;
            border-radius: 8px;
            padding: 12px;
            font-size: 12px;
            color: #94a3b8;
            line-height: 1.5;
        }

        .info-card b {
            color: #e2e8f0;
        }
    </style>
</head>
<body>

    <!-- Phone Screen Live View -->
    <div class="stream-container">
        <img id="phone-screen" src="/mobile-feed" alt="Phone Display Stream" />
    </div>

    <!-- Navigation & Hardware Controls -->
    <div class="controls-sidebar">
        <div>
            <div class="section-title">Navigation</div>
            <div class="btn-grid">
                <button class="control-btn" onclick="sendKey(4)">◀ Back</button>
                <button class="control-btn" onclick="sendKey(3)">● Home</button>
                <button class="control-btn" onclick="sendKey(187)">■ Apps</button>
            </div>
        </div>

        <div>
            <div class="section-title">Hardware Keys</div>
            <div class="btn-grid">
                <button class="control-btn" onclick="sendKey(24)">Vol +</button>
                <button class="control-btn" onclick="sendKey(25)">Vol -</button>
                <button class="control-btn" onclick="sendKey(26)">Power</button>
            </div>
        </div>

        <div>
            <div class="section-title">Type into Phone</div>
            <div class="input-group">
                <input type="text" id="phoneInput" class="text-field" placeholder="Type text to send..." onkeydown="if(event.key==='Enter') sendText()" />
                <button class="submit-btn" onclick="sendText()">Send to Device</button>
            </div>
        </div>

        <div class="info-card">
            • <b>Tap:</b> Left-click anywhere on the display.<br>
            • <b>Swipe:</b> Click & drag your mouse across the screen.<br>
            • <b>Resolution:</b> Scales automatically to your phone's native display.
        </div>
    </div>

    <script>
        const screenImg = document.getElementById('phone-screen');
        let startX = 0, startY = 0, isDragging = false;

        // Map web click coordinates to native mobile coordinates (1080x2400 scaling)
        function getTouchCoords(e) {
            const rect = screenImg.getBoundingClientRect();
            const normX = (e.clientX - rect.left) / rect.width;
            const normY = (e.clientY - rect.top) / rect.height;
            return {
                x: Math.round(normX * 1080),
                y: Math.round(normY * 2400)
            };
        }

        screenImg.addEventListener('mousedown', (e) => {
            isDragging = true;
            const coords = getTouchCoords(e);
            startX = coords.x;
            startY = coords.y;
        });

        screenImg.addEventListener('mouseup', (e) => {
            if (!isDragging) return;
            isDragging = false;
            const coords = getTouchCoords(e);
            
            const dragDistance = Math.hypot(coords.x - startX, coords.y - startY);
            if (dragDistance < 20) {
                // Execute Tap
                fetch('/api/tap', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ x: coords.x, y: coords.y })
                });
            } else {
                // Execute Swipe
                fetch('/api/swipe', {
                    method: 'POST',
                    headers: { 'Content-Type': 'application/json' },
                    body: JSON.stringify({ x1: startX, y1: startY, x2: coords.x, y2: coords.y, duration: 250 })
                });
            }
        });

        function sendKey(keycode) {
            fetch('/api/key', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ keycode })
            });
        }

        function sendText() {
            const inputField = document.getElementById('phoneInput');
            if (!inputField.value) return;
            fetch('/api/text', {
                method: 'POST',
                headers: { 'Content-Type': 'application/json' },
                body: JSON.stringify({ text: inputField.value })
            });
            inputField.value = '';
        }
    </script>
</body>
</html>
